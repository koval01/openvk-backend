HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://openvk:openvk@127.0.0.1:5432/openvk?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# 32-byte key as base64 or hex, or any passphrase (hashed to 32 bytes).
# Separate from JWT_SECRET. A stolen database dump is useless without this.
DATA_KEY=openvk-dev-data-key-change-me
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Set COOKIE_SECURE=1 behind HTTPS so session/CSRF cookies get the Secure flag.
# COOKIE_SECURE=0
# Seeded accounts: id1 / anna / pavel  password: openvk
DB_MAX_CONNECTIONS=32
DB_MIN_CONNECTIONS=2
RATE_LIMIT_PER_MINUTE=120
RUST_LOG=openvk_backend=debug,tower_http=debug,axum=info
# Optional. OPENVK_BUILD overrides the compile-time git short hash (x-openvk-build).
# OPENVK_INSTANCE_ID overrides the machine hostname (x-openvk-instance).
# OPENVK_BUILD=a229ef3
# OPENVK_INSTANCE_ID=openvk-api-1

# Milestone 2 — transactional email (unused until the dispatcher lands)
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=noreply@openvk.local

# Object storage. The API writes and deletes objects over the S3 API and never
# serves their bytes: browsers read them from MEDIA_PUBLIC_BASE_URL (nginx in
# front of Silo, or a CDN in front of R2). Nothing is written to disk.
#
# Without S3_* the API falls back to in-memory objects, which is fine for
# `cargo test` and a quick `cargo run`, but uploads die with the process.
STORAGE_BACKEND=s3
MAX_UPLOAD_BYTES=52428800

# Local Silo from `docker compose --profile dev up silo silo-init`.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=openvk
S3_REGION=auto
S3_ACCESS_KEY_ID=openvk
S3_SECRET_ACCESS_KEY=openvk-dev-secret
# Path style (endpoint/bucket/key) is what Silo and MinIO expect. R2 takes either.
S3_PATH_STYLE=1
# Dev: relative so localhost and 127.0.0.1 both hit the Vite /media proxy.
MEDIA_PUBLIC_BASE_URL=/media

# Cloudflare R2 over the same S3 API (create an R2 access key in the dashboard):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=openvk-media
# S3_REGION=auto
# S3_PATH_STYLE=0
# MEDIA_PUBLIC_BASE_URL=https://media.example.org

# Cloudflare Turnstile — dummy always-pass keys for local/test
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Dummy sitekey (frontend): 1x00000000000000000000AA
# The always-pass secret accepts any non-empty token; empty tokens are still rejected.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Default avatars: DiceBear Notionists SVG, fetched once per user, stored in the
# bucket. `{seed}` is the user id. Tests turn this off. Set to `off` to skip.
# DICEBEAR_URL=https://api.dicebear.com/10.x/notionists/svg?backgroundColor=ececed&inkColor=3b3d42&paperColor=fafafa&seed={seed}
# DICEBEAR_URL=off
